#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define WIN 1
#define NAV 2
#define SYM 3
#define ADJ 4
#define WNAV 5
#define WSYM 6

//testing mouse movement and scroll binds...

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            label = "PARA";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            label = "CAPS";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            label = "PARALESS";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            label = "PARAGREAT";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        // JIS-OS variants: send keycodes that produce US glyphs on a JIS-recognized OS

        paraless_jis: paraless_jis {
            compatible = "zmk,behavior-mod-morph";
            label = "PARALESS_JIS";
            bindings = <&kp LS(N8)>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        paragreat_jis: paragreat_jis {
            compatible = "zmk,behavior-mod-morph";
            label = "PARAGREAT_JIS";
            bindings = <&kp LS(N9)>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <13 29>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <15 21>;
        };

        perc {
            bindings = <&kp PERCENT>;
            key-positions = <5 17>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <4 16>;
        };

        pound {
            bindings = <&kp POUND>;
            key-positions = <3 15>;
        };

        copy {
            bindings = <&kp K_COPY>;
            key-positions = <28 27>;
        };

        paste {
            bindings = <&kp K_PASTE>;
            key-positions = <26 27>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <32 20>;
        };

        minus {
            bindings = <&kp KP_MINUS>;
            key-positions = <31 19>;
        };

        // US-layout OS (Mac) symbol combos

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <28 16>;
            layers = <0 2 3>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <2 14>;
            layers = <0 2 3>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <26 14>;
            layers = <0 2 3>;
        };

        star {
            bindings = <&kp STAR>;
            key-positions = <8 20>;
            layers = <0 2 3>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <7 19>;
            layers = <0 2 3>;
        };

        underscore {
            bindings = <&kp UNDER>;
            key-positions = <30 18>;
            layers = <0 2 3>;
        };

        leftbrack {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <31 32>;
            layers = <0 2 3>;
        };

        rightbrack {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <33 32>;
            layers = <0 2 3>;
        };

        para-less {
            bindings = <&paraless>;
            key-positions = <20 19>;
            layers = <0 2 3>;
        };

        para-great {
            bindings = <&paragreat>;
            key-positions = <20 21>;
            layers = <0 2 3>;
        };

        // JIS-recognized OS (Win) symbol combos — same positions, JIS keycodes

        equal_win {
            bindings = <&kp LS(MINUS)>;
            key-positions = <28 16>;
            layers = <1 5 6>;
        };

        at_win {
            bindings = <&kp LBKT>;
            key-positions = <2 14>;
            layers = <1 5 6>;
        };

        backslash_win {
            bindings = <&kp INT3>;
            key-positions = <26 14>;
            layers = <1 5 6>;
        };

        star_win {
            bindings = <&kp LS(SQT)>;
            key-positions = <8 20>;
            layers = <1 5 6>;
        };

        plus_win {
            bindings = <&kp LS(SEMI)>;
            key-positions = <7 19>;
            layers = <1 5 6>;
        };

        underscore_win {
            bindings = <&kp LS(INT1)>;
            key-positions = <30 18>;
            layers = <1 5 6>;
        };

        leftbrack_win {
            bindings = <&kp RBKT>;
            key-positions = <31 32>;
            layers = <1 5 6>;
        };

        rightbrack_win {
            bindings = <&kp NON_US_HASH>;
            key-positions = <33 32>;
            layers = <1 5 6>;
        };

        para-less-win {
            bindings = <&paraless_jis>;
            key-positions = <20 19>;
            layers = <1 5 6>;
        };

        para-great-win {
            bindings = <&paragreat_jis>;
            key-positions = <20 21>;
            layers = <1 5 6>;
        };
    };

    //

    keymap {
        compatible = "zmk,keymap";

        DEF_MAC {
            display-name = "Mac";

            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&trans  &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y      &kp U  &kp I      &kp O    &kp P      &trans
&trans  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H      &kp J  &kp K      &kp L    &kp RCTRL  &trans
&trans  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N      &kp M  &kp COMMA  &kp DOT  &kp RSHFT  &trans
                      &kp LGUI  &mo 2  &kp SPACE    &kp ENTER  &mo 3  &kp RALT
            >;
        };

        WIN_DEF {
            display-name = "Win";
            bindings = <
&trans  &kp Q  &kp W  &kp E      &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P      &trans
&trans  &kp A  &kp S  &kp D      &kp F  &kp G        &kp H    &kp J  &kp K      &kp L    &kp LGUI   &trans
&trans  &kp Z  &kp X  &kp C      &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp RSHFT  &trans
                      &kp LCTRL  &mo 5  &kp SPACE    &kp RET  &mo 6  &kp RALT
            >;
        };

        NAV {
            display-name = "Nav";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&trans  &kp ESC    &kp GRAVE     &kp LS(GRAVE)  &kp BSLH      &kp LS(BSLH)     &kp LG(F3)      &kp PG_DN  &kp PG_UP     &kp LG(F4)  &kp COLON  &trans
&trans  &kp TAB    &kp LS(LBKT)  &kp LS(RBKT)   &kp LS(LBKT)  &kp LS(EQUAL)    &kp LEFT_ARROW  &kp DOWN   &kp UP_ARROW  &kp RIGHT   &kp RCTRL  &trans
&trans  &kp LSHFT  &kp LALT      &kp LCTRL      &kp MINUS     &kp EQUAL        &kp SQT         &kp DQT    &kp LT        &kp GT      &trans     &trans
                                 &trans         &trans        &trans           &kp BACKSPACE   &trans     &trans
            >;
        };

        SYM {
            display-name = "Sym";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)       &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &trans
&trans  &kp N1      &kp N2      &kp N3      &kp N4      &kp N5           &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &trans
&trans  &kp LSHFT   &kp GRAVE   &kp TILDE   &kp MINUS   &kp TILDE        &kp SQT     &kp DQT     &kp COMMA   &kp DOT     &kp FSLH    &trans
                                &trans      &trans      &kp BACKSPACE    &trans      &trans      &trans
            >;
        };

        ADJ {
            display-name = "Adj";
            bindings = <
&trans  &kp ESC       &kp F2         &kp F3        &kp F4        &kp F5           &kp F6         &kp F7      &kp F8         &kp F9  &bt BT_CLR  &trans
&trans  &hm LGUI F11  &hm LSHFT F12  &kp PAGE_UP   &kp LG(F3)    &kp LG(SPACE)    &kp LC(SPACE)  &kp RG(F4)  &kp PAGE_DOWN  &trans  &trans      &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4     &trans         &trans      &trans         &to 0   &to 1       &trans
                                     &trans        &mo 4         &trans           &trans         &mo 4       &trans
            >;
        };

        WIN_NAV {
            display-name = "WNav";

            // Same as Nav, but sends JIS keycodes so a JIS-recognized OS types US glyphs

            bindings = <
&trans  &kp ESC    &kp LS(LBKT)  &kp LS(EQUAL)        &kp INT3      &kp LS(INT3)     &kp LG(F3)      &kp PG_DN   &kp PG_UP     &kp LG(F4)  &kp SQT    &trans
&trans  &kp TAB    &kp LS(RBKT)  &kp LS(NON_US_HASH)  &kp LS(RBKT)  &kp LS(SEMI)     &kp LEFT_ARROW  &kp DOWN    &kp UP_ARROW  &kp RIGHT   &kp RCTRL  &trans
&trans  &kp LSHFT  &kp LALT      &kp LCTRL            &kp MINUS     &kp LS(MINUS)    &kp LS(N7)      &kp LS(N2)  &kp LT        &kp GT      &trans     &trans
                                 &trans               &trans        &trans           &kp BACKSPACE   &trans      &trans
            >;
        };

        WIN_SYM {
            display-name = "WSym";

            // Same as Sym, but sends JIS keycodes so a JIS-recognized OS types US glyphs

            bindings = <
&trans  &kp LS(N1)  &kp LBKT      &kp LS(N3)     &kp LS(N4)  &kp LS(N5)       &kp EQUAL   &kp LS(N6)  &kp LS(SQT)  &kp LS(N8)  &kp LS(N9)  &trans
&trans  &kp N1      &kp N2        &kp N3         &kp N4      &kp N5           &kp N6      &kp N7      &kp N8       &kp N9      &kp N0      &trans
&trans  &kp LSHFT   &kp LS(LBKT)  &kp LS(EQUAL)  &kp MINUS   &kp LS(EQUAL)    &kp LS(N7)  &kp LS(N2)  &kp COMMA    &kp DOT     &kp FSLH    &trans
                                  &trans         &trans      &kp BACKSPACE    &trans      &trans      &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        ADJ {
            if-layers = <2 3>;
            then-layer = <4>;
        };

        ADJ_WIN {
            if-layers = <5 6>;
            then-layer = <4>;
        };
    };
};
